{
  "expo": {
    "name": "3-Bucket Strategy Simulation",
    "slug": "three-bucket-strategy-simulation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "threebucket",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.threebucketstrategy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.anonymous.threebucketstrategy"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "updates": {
      "url": "https://u.expo.dev/a06632e4-b847-442b-9d3b-d71e101462a6"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a06632e4-b847-442b-9d3b-d71e101462a6"
      }
    },
    "owner": "adk113"
  }
}
