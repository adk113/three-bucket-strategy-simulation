{
  "expo": {
    "name": "3-Bucket Strategy Simulation",
    "slug": "three-bucket-strategy-simulation",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "threebucket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.threebucketstrategy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F19",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.anonymous.threebucketstrategy"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "updates": {
      "url": "https://u.expo.dev/dd902338-e397-4b69-8268-c12afdd38f6a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "dd902338-e397-4b69-8268-c12afdd38f6a"
      }
    },
    "owner": "adk_113"
  }
}
